    "print('GPU available:', torch.cuda.is_available())\n",
    "print('Device:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-2",
   "metadata": {},
