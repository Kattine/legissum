   "source": [
    "# ── Cell 3: HuggingFace login (needed for Mistral gated model) ───────────────\n",
    "from huggingface_hub import login\n",
    "login()  # paste your HF token — get it at https://huggingface.co/settings/tokens"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 4: Upload your adapter (billsum-lora.zip) ───────────────────────────\n",
    "# Zip it on your Mac first:\n",
    "#   cd legissum/models && zip -r billsum-lora.zip billsum-lora/\n",
    "\n",
    "from google.colab import files\n",
    "import zipfile, os\n",
    "\n",
    "print('Select billsum-lora.zip from your Mac...')\n",
    "uploaded = files.upload()\n",
    "\n",
    "zip_name = list(uploaded.keys())[0]\n",
    "with zipfile.ZipFile(zip_name, 'r') as z:\n",
    "    z.extractall('.')\n",
    "\n",
    "ADAPTER_PATH = './billsum-lora'\n",
    "print(f'Adapter extracted to {ADAPTER_PATH}')\n",
    "print('Files:', os.listdir(ADAPTER_PATH))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 5: Load test data from BillSum ──────────────────────────────────────\n",
    "from datasets import load_dataset\n",
    "import json\n",
    "\n",
    "N_EVAL = 50\n",
    "\n",
    "SYSTEM = (\n",
    "    \"You are a legislative assistant helping everyday citizens understand U.S. law. \"\n",
    "    \"Read the following Congressional bill and write a clear, concise summary. \"\n",
    "    \"Focus on: what the bill does, who it affects, and its key provisions. \"\n",
    "    \"Use plain English — no legal jargon.\"\n",
    ")\n",
    "\n",
    "ds = load_dataset('FiscalNote/billsum')\n",
    "test_data = [\n",
    "    {\"input\": (r[\"title\"] + \"\\n\\n\" + r[\"text\"])[:3000], \"output\": r[\"summary\"]}\n",
    "    for r in list(ds[\"test\"])[:N_EVAL]\n",
    "    if len(r[\"text\"].split()) > 200 and len(r[\"summary\"].split()) > 20\n",
    "][:N_EVAL]\n",
    "\n",
    "print(f'Loaded {len(test_data)} test samples')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 6: Load model + generate summaries ──────────────────────────────────\n",
    "# Loads base model ONCE, generates base summaries, then applies adapter\n",
    "# and generates fine-tuned summaries — sequential to avoid OOM.\n",
    "\n",
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
    "from peft import PeftModel\n",
    "from tqdm import tqdm\n",
    "\n",
    "BASE_MODEL = 'mistralai/Mistral-7B-Instruct-v0.3'\n",
    "\n",
    "bnb = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type='nf4',\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_use_double_quant=True,\n",
    ")\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)\n",
    "tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "def summarize(model, text):\n",
    "    prompt = f'### Instruction:\\n{SYSTEM}\\n\\n### Bill:\\n{text[:3000]}\\n\\n### Summary:\\n'\n",
    "    inputs = tokenizer(prompt, return_tensors='pt', truncation=True, max_length=1024).to('cuda')\n",
    "    with torch.no_grad():\n",
    "        out = model.generate(\n",
    "            **inputs, max_new_tokens=300, temperature=0.3,\n",
    "            do_sample=True, pad_token_id=tokenizer.eos_token_id\n",
    "        )\n",
    "    decoded = tokenizer.decode(out[0], skip_special_tokens=True)\n",
    "    return decoded.split('### Summary:')[-1].strip()\n",
    "\n",
    "# ── Pass 1: Base model ────────────────────────────────────────────────────────\n",
    "print('Loading base model...')\n",
    "model = AutoModelForCausalLM.from_pretrained(BASE_MODEL, quantization_config=bnb, device_map='auto')\n",
    "model.eval()\n",
    "\n",
    "preds_base, refs = [], []\n",
    "print('Generating base model summaries...')\n",
    "for ex in tqdm(test_data):\n",
    "    preds_base.append(summarize(model, ex['input']))\n",
    "    refs.append(ex['output'])\n",
    "\n",
    "# ── Pass 2: Apply adapter ─────────────────────────────────────────────────────\n",
    "print('\\nApplying LoRA adapter...')\n",
    "model = PeftModel.from_pretrained(model, ADAPTER_PATH)\n",
    "model.eval()\n",
    "\n",
    "preds_ft = []\n",
    "print('Generating fine-tuned summaries...')\n",
    "for ex in tqdm(test_data):\n",
    "    preds_ft.append(summarize(model, ex['input']))\n",
    "\n",
    "print('\\nDone generating. Running BERTScore...')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Cell 7: BERTScore ─────────────────────────────────────────────────────────\n",
    "from bert_score import score as bert_score_fn\n",
    "import json\n",
    "\n",
    "print('Scoring base model...')\n",
    "P_b, R_b, F_b = bert_score_fn(preds_base, refs, lang='en', verbose=True)\n",
    "\n",
    "print('Scoring fine-tuned model...')\n",
    "P_f, R_f, F_f = bert_score_fn(preds_ft, refs, lang='en', verbose=True)\n",
    "\n",
    "scores_base = {'precision': round(P_b.mean().item(), 4),\n",
    "               'recall':    round(R_b.mean().item(), 4),\n",
    "               'f1':        round(F_b.mean().item(), 4)}\n",
    "scores_ft   = {'precision': round(P_f.mean().item(), 4),\n",
    "               'recall':    round(R_f.mean().item(), 4),\n",
    "               'f1':        round(F_f.mean().item(), 4)}\n",
    "\n",
    "print(f\"\\n{'Metric':<12} {'Base Model':>12} {'Fine-tuned':>12} {'Δ':>10}\")\n",
    "print('-' * 50)\n",
    "for k in ['precision', 'recall', 'f1']:\n",
    "    delta = scores_ft[k] - scores_base[k]\n",
    "    print(f\"{k:<12} {scores_base[k]:>12.4f} {scores_ft[k]:>12.4f} {delta:>+10.4f}\")\n",
    "\n",
    "with open('bertscore_scores.json', 'w') as f:\n",
    "    json.dump({'base': scores_base, 'finetuned': scores_ft,\n",
    "               'n_samples': len(refs)}, f, indent=2)\n",
    "print('\\nSaved to bertscore_scores.json')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-8",
   "metadata": {},
   "outputs": [],
