# Copy this file to .env and fill in values as needed.
# The app works without any of these — they are all optional overrides.

# Base model to load (default: mistralai/Mistral-7B-Instruct-v0.3)
# BASE_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

# HuggingFace Hub repo ID for the fine-tuned LoRA adapter.
# Set this if you pushed your adapter to HF Hub after training on Colab
# and don't have the local models/billsum-lora/ directory.
# Example: HF_MODEL_ID=yourname/legissum-lora
# HF_MODEL_ID=

# HuggingFace token (needed only if your model repo is private)
# HF_TOKEN=hf_...
